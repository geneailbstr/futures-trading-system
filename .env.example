# ============================================================
# Copy to .env and fill in your own values. Never commit .env.
# ============================================================

# ---- tastytrade (real-time CME market data via DXLink) ----
TASTYTRADE_USERNAME=your_username_here
TASTYTRADE_PASSWORD=your_password_here
TASTYTRADE_CLIENT_ID=your_oauth_client_id
TASTYTRADE_CLIENT_SECRET=your_oauth_client_secret
TASTYTRADE_REFRESH_TOKEN=your_refresh_token
TASTYTRADE_ENV=production          # production | sandbox

# ---- PickMyTrade (order routing webhook -> Tradovate) ----
PMT_TOKEN=your_pickmytrade_token
PMT_WEBHOOK_URL=https://example.invalid/webhook
PMT_ACCOUNT_ID=your_account_id

# ---- Notifications (optional) ----
NOTIFY_WEBHOOK_URL=
NOTIFY_ENABLED=false

# ---- Economic calendar / sentiment feeds (optional) ----
ECOCAL_API_KEY=
SENTIMENT_API_KEY=

# ---- Runtime toggles ----
USE_REAL_DATA=false                # false = replay/simulated feed
EXECUTION_ENABLED=false            # false = observe mode, no orders sent
LOG_LEVEL=INFO
