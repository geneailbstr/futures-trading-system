# ============================================================
# Copy to .env and fill in your own values. Never commit .env.
# ============================================================

# ---- Tradovate (broker account) ----
TRADOVATE_ACCOUNT_ID=your_account_id

# ---- tastytrade (real-time CME data via DXLink) ----
TASTYTRADE_CLIENT_SECRET=your_client_secret
TASTYTRADE_REFRESH_TOKEN=your_refresh_token

# ---- PickMyTrade (order routing) ----
PICKMYTRADE_TOKEN=your_token
PICKMYTRADE_WEBHOOK=https://example.invalid/webhook

# ---- Safety (safety.py) ----
# Hostname of the ONE machine allowed to send live orders (run `hostname` there).
# Set it only in that machine's .env; leave it out everywhere else.
BOT_LIVE_HOST=
# Tradovate DEMO account for pmt_bracket_test.py (must start with DEMO)
PMT_DEMO_ACCOUNT_ID=

# ---- Market data providers ----
DATABENTO_API_KEY=your_key
ALPHA_VANTAGE_API_KEY=your_key
FINNHUB_API_KEY=your_key

# ---- Sentiment analysis ----
ANTHROPIC_API_KEY=your_key

# ---- Email alerts ----
GMAIL_ADDRESS=you@gmail.com
GMAIL_APP_PASSWORD=your_app_password
NOTIFY_EMAIL=where_alerts_go@example.com
